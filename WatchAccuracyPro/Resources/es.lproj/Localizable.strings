"glossary.confidence" = "Confianza";
"glossary.confidence.desc" = "Puntuación de 0 a 100 que indica la fiabilidad de una medición. Depende del SNR, la duración, la calidad del enganche de BPH y el error de marcha.";
"glossary.snr" = "SNR (relación señal/ruido)";
"glossary.snr.desc" = "Relación entre el sonido del reloj y el ruido ambiente (dB). Cuanto mayor, mejor — se necesitan al menos 12 dB para un resultado fiable.";
"glossary.drift" = "Deriva";
"glossary.drift.desc" = "Tendencia de la marcha a cambiar con el tiempo debido a temperatura, posición o tensión del muelle real.";
"glossary.isochronism" = "Isocronismo";
"glossary.isochronism.desc" = "Capacidad de un movimiento para mantener una marcha constante sin importar la reserva de marcha restante. Mayor isocronismo significa precisión más estable.";
"glossary.positional" = "Variación posicional";
"glossary.positional.desc" = "Cuánto cambia la marcha según la orientación del reloj (esfera arriba, esfera abajo, posiciones de corona). Se comprueba con el test de 6 posiciones.";
"glossary.power_reserve" = "Reserva de Marcha";
"glossary.power_reserve.desc" = "Tiempo que el reloj funciona tras la cuerda completa. Habitualmente 38–80 h. Con poca energía baja la amplitud y la marcha puede caer por debajo de −20s/d.";
"glossary.overhaul" = "Revisión Completa (Overhaul)";
"glossary.overhaul.desc" = "Servicio completo — desmontar, limpiar, relubricar y volver a montar el movimiento. Recomendado cada 4–6 años.";
"glossary.magnetism" = "Magnetismo";
"glossary.magnetism.desc" = "Secadores, altavoces o accesorios MagSafe cerca pueden magnetizar la espiral, haciendo que la marcha vaya muy rápida. Desmagnetiza para restablecer.";
"glossary.escapement" = "Escape";
"glossary.escapement.desc" = "Pieza clave que libera la energía del muelle real a un ritmo constante. Áncora suiza (la mayoría), Coaxial (Omega), Spring drive (Seiko), etc.";

