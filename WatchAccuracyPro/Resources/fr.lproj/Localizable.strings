"glossary.overhaul" = "Révision (Overhaul)";
"glossary.overhaul.desc" = "Service complet — démontage, nettoyage, ré-huilage et remontage du mouvement. Recommandé tous les 4–6 ans.";
"glossary.magnetism" = "Magnétisme";
"glossary.magnetism.desc" = "Sèche-cheveux, haut-parleurs et accessoires MagSafe peuvent magnétiser le spiral, faisant accélérer la marche. Démagnétiser pour restaurer.";
"glossary.escapement" = "Échappement";
