"glossary.power_reserve" = "पावर रिज़र्व (Power Reserve)";
"glossary.power_reserve.desc" = "फ़ुल वाइंडिंग के बाद घड़ी कितने समय तक चलती है। आमतौर पर 38–80 घंटे। पावर कम होने पर एम्प्लीट्यूड गिरती है और रेट −20s/d से नीचे जा सकता है।";
"glossary.overhaul" = "ओवरहॉल (Overhaul)";
